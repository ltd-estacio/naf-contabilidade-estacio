# Configuração de Email para envio de backups
# IMPORTANTE: Copie este arquivo para .env.local e preencha com suas credenciais

# Email remetente (Gmail)
EMAIL_USER=seu-email@gmail.com

# Senha de aplicativo do Gmail
# Para gerar: https://myaccount.google.com/apppasswords
# 1. Acesse sua conta Google
# 2. Ative verificação em 2 etapas
# 3. Vá em "Senhas de app"
# 4. Gere uma senha para "Email"
# 5. Cole aqui (formato: xxxx xxxx xxxx xxxx)
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

