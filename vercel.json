{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "app/api/automation/run/route.js": {
      "includeFiles": [
        "public/playwright-aws-lambda/bin/**",
        "node_modules/playwright-aws-lambda/dist/src/bin/**"
      ]
    },
    "app/api/automation/run/route.mjs": {
      "includeFiles": [
        "public/playwright-aws-lambda/bin/**",
        "node_modules/playwright-aws-lambda/dist/src/bin/**"
      ]
    }
  }
}
